&share
 max_dom = 2,
 start_date = 'STARTDATE','STARTDATE','STARTDATE',
 end_date   = 'ENDDATE','ENDDATE','ENDDATE',
 interval_seconds = 21600
/
 

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,   36,
 j_parent_start    =   1,   32,
 e_we              =   112,   151,
 e_sn              =   112,   142,
 geog_data_res     = 'modis_30s+10m','modis_30s+2m','modis_30s+30s'
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   =  36.65,
 ref_lon   = 106.45,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon = 106.45,
 geog_data_path = '/apps/geog/'
/


&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/


&metgrid
 fg_name = 'FILE'
 io_form_metgrid = 2, 
/
